# Copy this file to `.env` and fill in the real values.
# Never commit `.env`.

# --- Database -------------------------------------------------------------
# Example PostgreSQL connection strings:
#
# Neon:     postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Local:    postgresql://postgres:postgres@localhost:5432/codeforge
#
# Connection used by the application (lib/db.ts). On Supabase: Transaction
# Pooler (port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DBNAME?pgbouncer=true"

# Direct connection (no pooler) used by the Prisma CLI for
# migrations. On Supabase: Session Pooler or direct connection (port 5432).
# Needed for `prisma migrate deploy`; if missing, DATABASE_URL is used.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Auth.js --------------------------------------------------------------
# A different secret per environment: openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="change-me-to-a-32-char-random-string-please-xxxxxxxx"

# Behind a proxy or on Vercel preview deployments.
AUTH_TRUST_HOST=true

# Tests only: sign-in without a verified email. lib/env.ts refuses to
# start if this variable is "true" with NODE_ENV=production.
# AUTH_ALLOW_UNVERIFIED_LOGIN=true

# Number of trusted proxies in front of the application, to read the real
# client IP from X-Forwarded-For (lib/rate-limit.ts). 1 by default (Vercel or
# a single reverse proxy).
# TRUSTED_PROXY_HOPS=1

# --- Email (Resend) -------------------------------------------------------
# Key to create at https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender. In development, "onboarding@resend.dev" (the free plan
# only sends to the account's address). Once the domain is verified:
#   "La Forge du Code <noreply@laforgeducode.fr>"
RESEND_FROM_EMAIL="La Forge du Code <onboarding@resend.dev>"
# Base URL for links sent by email, without a trailing slash. In production,
# the real https domain, otherwise the verification links do not work.
APP_URL="http://localhost:3000"

# --- Rate limiting (required on Vercel) -----------------------------------
# By default the counters are in memory, which is enough for a single
# instance. On serverless (Vercel), an Upstash Redis shares the counters across
# instances; lib/env.ts requires it on Vercel (audit SRV-01).
# Upstash names, or those set by Vercel's Upstash integration:
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"
# KV_REST_API_URL="https://xxxx.upstash.io"
# KV_REST_API_TOKEN="xxxxxxxx"

# --- Error tracking (optional, Sentry) ------------------------------------
# Without SENTRY_DSN, Sentry is inactive and server errors only go
# through lib/logger.ts.
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
