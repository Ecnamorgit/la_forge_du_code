# Copy this file to `.env` and fill in real values.
# Never commit `.env` itself.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Examples below.
#
# Neon:     postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Local:    postgresql://postgres:postgres@localhost:5432/codeforge
#
# Runtime connection (used by the app via lib/db.ts). On Supabase use the
# Transaction Pooler (port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DBNAME?pgbouncer=true"

# Direct (non-pooled) connection used by the Prisma CLI for migrations.
# On Supabase use the Session Pooler / direct connection (port 5432).
# Required for `prisma migrate deploy`. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Auth.js --------------------------------------------------------------
# Generate a UNIQUE secret per environment with: openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# NEVER reuse the dev secret in production.
AUTH_SECRET="change-me-to-a-32-char-random-string-please-xxxxxxxx"

# When running behind a proxy / on Vercel preview deployments.
AUTH_TRUST_HOST=true

# Test-only: allow login without a verified email. NEVER set this in
# production — the env validator (lib/env.ts) refuses to boot if it is "true"
# when NODE_ENV=production.
# AUTH_ALLOW_UNVERIFIED_LOGIN=true

# --- Email (Resend) ----------------------------------------------------
# Create an API key at https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender. Use "onboarding@resend.dev" during dev (free tier only sends
# to the account email). Once your domain is verified on Resend, e.g.
#   "Nebula Command <noreply@mail.codeforge.com>"
RESEND_FROM_EMAIL="Nebula Command <onboarding@resend.dev>"
# Base URL used in email links (no trailing slash). MUST be set to the real
# https://... domain in production, otherwise verification/reset links break.
APP_URL="http://localhost:3000"

# --- Rate limiting (optionnel) -------------------------------------------
# Par défaut le rate-limiter est en mémoire (suffisant pour une instance
# unique). Sur un déploiement multi-instance / serverless (Vercel), renseigne
# un Redis Upstash pour partager les compteurs entre instances.
# Crée une base sur https://upstash.com puis copie l'URL REST + le token.
# Si ces deux variables sont absentes, le fallback mémoire reste actif.
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# --- Monitoring d'erreurs (optionnel, Sentry) ----------------------------
# Sans SENTRY_DSN, le monitoring est totalement inerte (les erreurs serveur
# restent loggées via lib/logger.ts). Crée un projet sur https://sentry.io
# et copie le DSN ici pour activer la remontée des erreurs serveur.
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
