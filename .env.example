# Copy this file to `.env` and fill in real values.
# Never commit `.env` itself.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Examples below.
#
# Neon:     postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Local:    postgresql://postgres:postgres@localhost:5432/codeforge
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-char-random-string-please-xxxxxxxx"

# When running behind a proxy / on Vercel preview deployments.
AUTH_TRUST_HOST=true

# --- Email (Resend) ----------------------------------------------------
# Create an API key at https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender. Use "onboarding@resend.dev" during dev (free tier only sends
# to the account email). Once your domain is verified on Resend, e.g.
#   "Nebula Command <noreply@mail.codeforge.com>"
RESEND_FROM_EMAIL="Nebula Command <onboarding@resend.dev>"
# Base URL used in email links (no trailing slash). Override in prod.
APP_URL="http://localhost:3000"
