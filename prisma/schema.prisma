// Schéma Prisma de La Forge du Code (PostgreSQL). L'URL est configurée dans
// prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modèles requis par l'adaptateur Prisma d'Auth.js

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Champs propres à l'application
  username     String    @unique
  password     String? // haché ; null pour un compte OAuth seul
  // Incrémentée à chaque réinitialisation de mot de passe pour révoquer les
  // sessions JWT émises avant (audit SRV-03) : le jeton porte la version lue à
  // la connexion, et une divergence invalide la session.
  sessionVersion Int      @default(0)
  joinedAt     DateTime  @default(now())
  totalXp      Int       @default(0)
  streak       Int       @default(1)
  lastVisit         String    @default("") // date ISO (yyyy-mm-dd) du dernier jour actif (travail réel, pas simple visite)
  lastDailyMission  String    @default("") // date ISO du jour auquel se rapporte dailyClaimed
  lastVisitedCourse String? // slug du dernier cursus pratiqué
  onboardedAt       DateTime? // null tant que le briefing de première connexion n'est pas terminé

  // Boucle quotidienne
  bestStreak        Int     @default(1) // record permanent de liaison
  streakShields     Int     @default(0) // relais de secours détenus (max 2)
  shieldEverGranted Boolean @default(false) // le relais offert du 3e jour n'est donné qu'une fois
  questsCompleted   Int     @default(0) // total d'ordres validés (badges de conduite)
  perfectBriefingRun Int    @default(0) // briefings complets d'affilée
  lastPerfectDay    String  @default("") // date ISO du dernier briefing complet
  dailyClaimed      Int     @default(0) // masque de bits : 0-2 = les 3 ordres, 3 = clôture

  // Cosmétiques déblocables (null = valeur par défaut du catalogue)
  frame  String?
  title  String?
  emblem String?
  cardBg String?

  // Avatar, purement cosmétique : null jusqu'à la première configuration sur /avatar.
  species      String? // "humain" | "cyborg" | "synthetique" | "hybride" | "inconnue"
  uniformColor String? // "cyan" | "orange" | "green" | "purple" | "gold"
  role         String? // "pilote" | "ingenieur" | "tacticien" | "explorateur"

  accounts        Account[]
  sessions        Session[]
  badges          UserBadge[]
  unlocks         UserUnlock[]
  stepCompletions StepCompletion[]
  oneTimeTokens   OneTimeToken[]
  cinematicViews  CinematicView[]
}

// Jetons à usage unique (vérification d'e-mail, réinitialisation du mot de
// passe) : `kind` en donne l'usage, `usedAt` empêche la réutilisation.
model OneTimeToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  kind      String // "email_verify" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Progression

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model UserUnlock {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model StepCompletion {
  id          String   @id @default(cuid())
  userId      String
  course      String
  chapter     String
  stepIndex   Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, course, chapter, stepIndex])
  @@index([userId, completedAt])
}

model CinematicView {
  id          String   @id @default(cuid())
  userId      String
  cinematicId String
  viewedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cinematicId])
  @@index([userId])
}

/// Comptage agrégé du tunnel d'acquisition. Aucune donnée personnelle :
/// pas d'IP, pas d'identifiant de visiteur, seulement un nom d'évènement
/// et une date.
model TrackEvent {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
