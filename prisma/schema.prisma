// Prisma schema for La Forge du Code (PostgreSQL). The URL is configured in
// prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Models required by the Auth.js Prisma adapter

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Application-specific fields
  username     String    @unique
  password     String? // hashed; null for an OAuth-only account
  // Incremented on every password reset to revoke the JWT sessions
  // issued before (audit SRV-03): the token carries the version read at
  // sign-in, and a mismatch invalidates the session.
  sessionVersion Int      @default(0)
  joinedAt     DateTime  @default(now())
  totalXp      Int       @default(0)
  streak       Int       @default(1)
  lastVisit         String    @default("") // ISO date (yyyy-mm-dd) of the last active day (real work, not just a visit)
  lastDailyMission  String    @default("") // ISO date of the day dailyClaimed refers to
  lastVisitedCourse String? // slug of the last course practiced
  onboardedAt       DateTime? // null until the first-sign-in briefing is finished

  // Daily loop
  bestStreak        Int     @default(1) // all-time liaison record
  streakShields     Int     @default(0) // backup relays held (max 2)
  shieldEverGranted Boolean @default(false) // the free relay on day 3 is only given once
  questsCompleted   Int     @default(0) // total orders completed (conduct badges)
  perfectBriefingRun Int    @default(0) // complete briefings in a row
  lastPerfectDay    String  @default("") // ISO date of the last complete briefing
  dailyClaimed      Int     @default(0) // bitmask: 0-2 = the 3 orders, 3 = wrap-up

  // Unlockable cosmetics (null = catalog default)
  frame  String?
  title  String?
  emblem String?
  cardBg String?

  // Avatar, purely cosmetic: null until the first setup on /avatar.
  species      String? // "humain" | "cyborg" | "synthetique" | "hybride" | "inconnue"
  uniformColor String? // "cyan" | "orange" | "green" | "purple" | "gold"
  role         String? // "pilote" | "ingenieur" | "tacticien" | "explorateur"

  accounts        Account[]
  sessions        Session[]
  badges          UserBadge[]
  unlocks         UserUnlock[]
  stepCompletions StepCompletion[]
  oneTimeTokens   OneTimeToken[]
  cinematicViews  CinematicView[]
}

// One-time tokens (email verification, password reset): `kind` gives
// their purpose, `usedAt` prevents reuse.
model OneTimeToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  kind      String // "email_verify" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Progress

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model UserUnlock {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model StepCompletion {
  id          String   @id @default(cuid())
  userId      String
  course      String
  chapter     String
  stepIndex   Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, course, chapter, stepIndex])
  @@index([userId, completedAt])
}

model CinematicView {
  id          String   @id @default(cuid())
  userId      String
  cinematicId String
  viewedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cinematicId])
  @@index([userId])
}

/// Aggregated count of the acquisition funnel. No personal data:
/// no IP, no visitor identifier, only an event name
/// and a date.
model TrackEvent {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
