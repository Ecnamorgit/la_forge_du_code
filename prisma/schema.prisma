// Prisma schema for Nebula Command (CodeForge)
// PostgreSQL for production-ready persistence. URL is configured in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js core models (Prisma adapter requirements) -------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // App-specific fields
  username     String    @unique
  password     String? // hashed (credentials provider); null for OAuth-only users
  joinedAt     DateTime  @default(now())
  totalXp      Int       @default(0)
  streak       Int       @default(1)
  lastVisit    String    @default("") // ISO date (yyyy-mm-dd)
  onboardedAt  DateTime? // null until the user finishes the first-login briefing

  accounts        Account[]
  sessions        Session[]
  badges          UserBadge[]
  stepCompletions StepCompletion[]
  oneTimeTokens   OneTimeToken[]
}

// Single-use tokens for email verification + password reset.
// `kind` discriminates the purpose; `usedAt` enforces single-use semantics.
model OneTimeToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  kind      String // "email_verify" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App-specific progress models ----------------------------------------

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model StepCompletion {
  id          String   @id @default(cuid())
  userId      String
  course      String
  chapter     String
  stepIndex   Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, course, chapter, stepIndex])
}
